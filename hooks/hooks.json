{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/arch-check.sh",
            "timeout": 10000,
            "statusMessage": "Checking architectural constraints..."
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/safety-check.sh",
            "timeout": 5000,
            "statusMessage": "Checking for risk patterns..."
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/plan-validation-check.sh",
            "timeout": 5000,
            "statusMessage": "Checking execution-plan handoff completeness..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/bash-safety-check.sh",
            "timeout": 3000,
            "statusMessage": "Checking bash command for credential leaks..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-metrics.sh",
            "timeout": 2000,
            "statusMessage": "Recording metrics..."
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/self-verify-check.sh",
            "timeout": 5000,
            "statusMessage": "Self-verifying edit..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-metrics.sh",
            "timeout": 2000,
            "statusMessage": "Recording metrics..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/doc-drift-check.sh",
            "timeout": 8000,
            "statusMessage": "Checking for documentation drift..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/doc-drift-check.sh",
            "timeout": 3000,
            "statusMessage": "Reading gate state..."
          }
        ]
      }
    ]
  }
}
