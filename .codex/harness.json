{
  "version": "2.1",
  "pillars": [
    "architecture",
    "documentation",
    "observability",
    "entropy"
  ],
  "plugin_structure": {
    "note": "Codex plugin; component directories are not target application layers.",
    "components": {
      "skills": "skills/",
      "hooks": "hooks/",
      "templates": "templates/",
      "docs": "docs/"
    }
  },
  "target_layer_model": {
    "note": "The layer model that oh-my-agents enforces on target projects via arch-check.sh and /arch-guard.",
    "layers": [
      "types",
      "config",
      "repo",
      "service",
      "runtime",
      "ui"
    ],
    "default_layer_dirs": {
      "types": [
        "**/types/**",
        "**/models/**",
        "**/interfaces/**"
      ],
      "config": [
        "**/config/**",
        "**/configuration/**"
      ],
      "repo": [
        "**/repo/**",
        "**/repository/**",
        "**/dal/**"
      ],
      "service": [
        "**/service/**",
        "**/services/**"
      ],
      "runtime": [
        "**/runtime/**",
        "**/server/**",
        "**/api/**"
      ],
      "ui": [
        "**/ui/**",
        "**/components/**",
        "**/pages/**",
        "**/views/**"
      ]
    }
  },
  "providers_path": null,
  "_config_note": "Plugin source is mostly Markdown and Bash. Skill instructions are limited to 400 lines; new target projects use templates/harness-config.json.",
  "file_size_limit": 800,
  "plan_stale_days": 7,
  "sibling_layers": [],
  "nested_agents_md_threshold": 3
}
