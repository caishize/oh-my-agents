{
  "version": "1.3",
  "harness": {
    "plugin": "oh-my-agents",
    "version": "3.4.0",
    "root": "."
  },
  "gstack": {
    "detected": true,
    "path": "/root/.claude/skills/gstack",
    "version": "1.28.0.0",
    "version_match": "loose",
    "min_supported": "1.26.0.0",
    "milestone_pin": "Memory Ingest v1 (v1.26+) + gstack-brain → gstack-artifacts rename (v1.27+) + llms.txt index (v1.28+)"
  },
  "project": {
    "slug": "oh-my-agents"
  },
  "_bridge_doc": "Paths are dual-value where gstack v1.27.0.0 introduced renames. Consumers glob BOTH legacy and current; first hit wins; absence is graceful degrade.",
  "bridges": {
    "design_docs":              "~/.gstack/projects/oh-my-agents/*-design-*.md",
    "test_plans":               "~/.gstack/projects/oh-my-agents/*-test-plan-*.md",
    "review_logs":              "~/.gstack/projects/oh-my-agents/*-reviews.jsonl",
    "qa_outcomes":              "~/.gstack/projects/oh-my-agents/*-test-outcome-*.md",
    "codex_reports":            "~/.gstack/projects/oh-my-agents/*-codex-*.md",
    "cso_reports":              "~/.gstack/projects/oh-my-agents/*-cso-*.md",
    "ux_audit_reports":         "~/.gstack/projects/oh-my-agents/*-ux-audit-*.md",
    "canary_reports":           ".gstack/canary-reports/*.json",
    "deploy_reports":           ".gstack/deploy-reports/*.json",
    "landing_reports_local":    ".gstack/landing-reports/*.json",
    "landing_reports_project":  "~/.gstack/projects/oh-my-agents/*-landing-*.md",
    "conductor_state":          "conductor.json",
    "conductor_workspaces":     "~/conductor/workspaces/",
    "worktrees_root":           ".gstack-worktrees/",
    "gbrain_worktree_current":  "~/.gstack-artifacts-worktree/",
    "gbrain_worktree_legacy":   "~/.gstack-brain-worktree/",
    "gbrain_learnings_current": "~/.gstack-artifacts-worktree/learnings-*.jsonl",
    "gbrain_learnings_legacy":  "~/.gstack-brain-worktree/learnings-*.jsonl",
    "gbrain_learnings_fallback":"~/.gstack/projects/oh-my-agents/*-learnings-*.jsonl",
    "gbrain_timeline_current":  "~/.gstack-artifacts-worktree/timeline-*.jsonl",
    "gbrain_timeline_legacy":   "~/.gstack-brain-worktree/timeline-*.jsonl",
    "gbrain_review_current":    "~/.gstack-artifacts-worktree/review-*.jsonl",
    "gbrain_review_legacy":     "~/.gstack-brain-worktree/review-*.jsonl",
    "gbrain_profile_current":   "~/.gstack-artifacts-worktree/developer-profile-*.json",
    "gbrain_profile_legacy":    "~/.gstack-brain-worktree/developer-profile-*.json",
    "gbrain_repo_policy":       "~/.gstack/gbrain-repo-policy.json",
    "gbrain_cli_probe":         "command -v gbrain",
    "gstack_llms_txt":          "<gstack_root>/llms.txt",
    "gstack_memory_ingest_bin": "<gstack_root>/bin/gstack-memory-ingest",
    "gstack_artifacts_remote":  "~/.gstack-artifacts-remote.txt",
    "exec_plans":               "docs/exec-plans/active/*.json",
    "verify_metrics":           ".claude/metrics/verify.jsonl",
    "verify_signal":            ".claude/signals/verify-latest.json",
    "review_metrics":           ".claude/metrics/reviews.jsonl",
    "review_signal":            ".claude/signals/review-latest.json",
    "session_metrics":          ".claude/metrics/session-*.jsonl",
    "confusion_metrics":        ".claude/metrics/confusion.jsonl",
    "gstack_skill_usage":       "~/.gstack/analytics/skill-usage.jsonl",
    "gstack_eureka":            "~/.gstack/analytics/eureka.jsonl"
  },
  "composition": {
    "slop_deep_check":   "gstack:/codex",
    "security_audit":    "gstack:/cso",
    "ux_audit":          "gstack:/ux-audit",
    "cross_model_qa":    "gstack:/codex",
    "observation_layer": "gstack:learnings-log + gbrain search (read-only, dual-value path)",
    "deploy_metrics":    "gstack:/landing-report (read-only)",
    "memory_ingest":     "gstack:bin/gstack-memory-ingest (gstack-internal; we never invoke or write)",
    "harness_owns":      ["arch-guard", "layer-enforcement", "entropy-sweep", "encode-mistake", "doc-drift", "secrets-hook", "legibility-score", "review-decision-signal"],
    "gstack_owns":       ["/office-hours", "/autoplan", "/ship", "/land-and-deploy", "/canary", "/landing-report", "/retro", "/investigate", "/qa", "/codex", "/cso", "/ux-audit", "/setup-gbrain", "/sync-gbrain", "/health"],
    "ignored":           ["/gstack-claude", "/scrape", "/skillify", "/pair-agent", "/open-gstack-browser", "/browse", "/setup-deploy"],
    "dedup_tags":        ["[HARNESS]", "[STRUCTURAL]", "[CROSS-MODEL]", "[SECURITY]", "[UX]", "[BOTH+]"],
    "decision_tags":     ["APPROVE", "REQUEST_CHANGES", "NEEDS_HUMAN"]
  },
  "policies": {
    "read_only_bridge": true,
    "graceful_degradation": true,
    "no_duplicate_metrics": true,
    "glob_over_exact_path": true,
    "loose_version_match": true,
    "worktree_aware": true,
    "gbrain_read_only": true,
    "bridge_dual_value": true,
    "no_orchestration": true,
    "human_gated_rule_encoding": true,
    "contract_lightweight_each_status": true,
    "review_contract_quarter": "2026-Q3",
    "principles_anchor": "docs/TEAM-DISCUSSION-2026-05-08.md"
  }
}
